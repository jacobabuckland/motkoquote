# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NOT READ BY THIS APP, and deliberately so — nothing in src/ references it, and
# tests/regression/app-store-link.test.ts holds it that way. The download button
# lives on the marketing site (site/index.html), which is static HTML with no
# build step and therefore no env vars: the listing URL is written there
# literally, and that is the single place that owns it. Setting this variable on
# the motkoquote Vercel project changes nothing.
#
# Kept documented because resolveAppStoreHref (src/lib/app-store-link.ts) still
# exists as the guard any future caller must use, and because the rule it
# encodes is the useful part: an unset, empty or unusable value means the
# download button DOES NOT RENDER. There is no search fallback — a plausible
# link to a search results page told every visitor the app did not exist.
NEXT_PUBLIC_APP_STORE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=

# Whisper (OpenAI)
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Handed to the browser in the create-payment-intent response, so it is read at
# runtime on the server and needs no NEXT_PUBLIC_ prefix. Prefer this one:
# NEXT_PUBLIC_ values are inlined at build time and come out empty if the value
# was not readable during the build (e.g. marked sensitive on the host).
STRIPE_PUBLISHABLE_KEY=
# Legacy fallback, still honoured if STRIPE_PUBLISHABLE_KEY is unset.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NOTE: there is no fee env var. The motko fee is not configurable per
# environment — it is the flat, capped £2/£4 defined in src/lib/motko-fee.ts,
# applied as a Stripe application fee at payment time.

# Resend (email)
RESEND_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Companies House API
COMPANIES_HOUSE_API_KEY=

# Google Maps Platform (address autocomplete — Places API New)
# Public (browser) key, restrict by HTTP referrer + Places API only. See README.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys`.
# Public key is exposed to the browser to subscribe; private key stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@motko.app

# Apple Push Notification service (native iOS app — token-based .p8 auth).
# APNS_PRIVATE_KEY holds the .p8 contents with newlines escaped as \n.
# APNS_ENV: "sandbox" for dev builds, "production" for App Store / TestFlight.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=app.motko.ios
APNS_ENV=sandbox

# Cron — REQUIRED in every deployed environment. Protects /api/cron/* routes,
# which move money (collect-fees, retry-fee-collections), delete data
# (purge-accounts), and message customers (chase). The routes fail CLOSED: if
# this is unset they reject every request with 401, so an unset secret disables
# all crons rather than exposing them publicly. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Error reporting (Sentry) — OPTIONAL, and the app is fully inert without it.
# With no DSN set, Sentry is never initialised: the gate's `npm run build` and
# the whole test suite run with none of these configured and must keep passing.
#
# The DSN is NEXT_PUBLIC_ because the browser needs it to report at all. It is
# a write-only ingest endpoint, not a credential, and is designed to be public
# — publishing it in the client bundle discloses nothing.
NEXT_PUBLIC_SENTRY_DSN=
# Performance tracing, 0..1. Left unset (= off) deliberately: tracing is billed
# by volume and its spans carry request URLs, which in this app contain job,
# quote and invoice ids. Turn it on as a decision, not by inheriting a default.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build-time only, for uploading source maps so stack traces are readable.
# SENTRY_AUTH_TOKEN *is* secret and must never be NEXT_PUBLIC_. Without it,
# source-map upload is skipped rather than failing the build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
